{
  "routes": [
    { "route": "/", "rewrite": "/index.html" },
    { "route": "/.*", "statusCode": 404 },
    { "route": "/node_modules/*", "statusCode": 404 },
    { "route": "/jspm_packages/*", "statusCode": 404 },
    { "route": "/bower_components/*", "statusCode": 404 },
    { "route": "/web_modules/*", "statusCode": 404 },
    { "route": "/logs/*", "statusCode": 404 },
    { "route": "/pids/*", "statusCode": 404 },
    { "route": "/lib-cov/*", "statusCode": 404 },
    { "route": "/coverage/*", "statusCode": 404 },
    { "route": "/build/*", "statusCode": 404 },
    { "route": "/out/*", "statusCode": 404 },
    { "route": "/dist/*", "statusCode": 404 },
    { "route": "/report.*", "statusCode": 404 },
    { "route": "/*.{log,pid,seed,lock,lcov,tsbuildinfo,tgz}", "statusCode": 404 },
    { "route": "/package.json", "statusCode": 404 },
    { "route": "/package-lock.json", "statusCode": 404 },
    { "route": "/eslint.config.mjs", "statusCode": 404 },
    { "route": "/staticwebapp.config.json", "statusCode": 404 },
    { "route": "/CLAUDE.md", "statusCode": 404 },
    { "route": "/*.md", "statusCode": 404 }
  ]
}
